FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      Gauss linearUpwind grad(U);

    div(phi,k)      Gauss upwind;
    div(phi,omega)  Gauss upwind;

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}
wallDist
{
    method          meshWave;
}